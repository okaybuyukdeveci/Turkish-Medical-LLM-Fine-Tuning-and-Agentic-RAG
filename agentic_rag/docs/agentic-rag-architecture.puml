@startuml agentic_rag_architecture
!theme plain
title Turkish Medical Agentic RAG

package "Indexing (explicit lifecycle)" {
  [data/*.md] --> [Markdown loader]
  [Markdown loader] --> [# / ## parser]
  [# / ## parser] --> [2000-token parents]
  [2000-token parents] --> [Local SQLite parent store]
  [2000-token parents] --> [250-token children]
  [250-token children] --> [E5 passage embeddings]
  [E5 passage embeddings] --> [Local Qdrant children]
  [Corpus + settings] --> [Index manifest]
}

package "Retrieval" {
  [User search query] --> [E5 query embedding]
  [E5 query embedding] --> [Local Qdrant children]
  [Local Qdrant children] --> [Parent ID lookup]
  [Local SQLite parent store] --> [Parent ID lookup]
  [Parent ID lookup] --> [Source-labelled parent evidence]
}

package "LangGraph" {
  [START] --> [Responder]
  [Responder] --> [Retrieval Tool] : one tool call
  [Retrieval Tool] --> [Pruner]
  [Pruner] --> [Responder] : labelled evidence
  [Responder] --> [Compactor] : final Turkish answer
  [Compactor] --> [END]
}

[Source-labelled parent evidence] --> [Retrieval Tool]

note right of [Index manifest]
Missing index: create
Exact match: reuse
Mismatch: fail until --force
end note

note right of [250-token children]
page_content repeats:
# title
## optional subtitle
body
end note
@enduml
